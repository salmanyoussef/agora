# ---- LLM provider: openai | azure (plug-and-play) ----
LLM_PROVIDER=openai

# ---- OpenAI (required when LLM_PROVIDER=openai) ----
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_CHAT_MAX_TOKENS=64000
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---- Azure OpenAI (required when LLM_PROVIDER=azure) ----
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE_NAME.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBED_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_CHAT_API_VERSION=2024-12-01-preview

# ---- Weaviate ----
WEAVIATE_URL=http://localhost:8080
WEAVIATE_GRPC_HOST=localhost
WEAVIATE_GRPC_PORT=50051
DATASETS_COLLECTION=Dataset

# Optional: if you later enable Weaviate API key auth
# WEAVIATE_API_KEY=YOUR_WEAVIATE_API_KEY

# Demo: faster technical runs (RLM with fewer iterations, 1 resource/dataset, max 5 datasets)
# AGORA_DEMO_MODE=true
